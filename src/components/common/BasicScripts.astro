---
/*
 * Site behaviour that must survive Astro view transitions (ClientRouter replaces <body> on each navigation).
 *
 * Rules, so nothing accumulates during a session:
 *   - Listeners on document/window/matchMedia are added once, when this module first runs.
 *   - Page-specific work (observers, header measurements) runs on `astro:page-load`, and the previous page's
 *     observers are disconnected first.
 */
---

<script>
  // ---- Mobile menu (disclosure) -------------------------------------------------------------------------------

  const desktop = window.matchMedia('(min-width: 1024px)');

  function menuParts() {
    return {
      header: document.getElementById('header'),
      button: document.querySelector<HTMLButtonElement>('[data-aw-toggle-menu]'),
      panel: document.querySelector<HTMLElement>('[data-menu-panel]'),
    };
  }

  // Make the page behind the open menu unreachable for keyboard and screen-reader users.
  // The cookie banner stays reachable, so both consent buttons always work.
  function setBackgroundInert(inert: boolean) {
    document.querySelectorAll<HTMLElement>('main, footer').forEach((el) => {
      el.inert = inert;
    });
  }

  function setMenu(open: boolean, { restoreFocus = false } = {}) {
    const { header, button, panel } = menuParts();
    if (!button || !panel) return;
    // At desktop width the panel is the normal inline nav; never treat it as open.
    const isOpen = open && !desktop.matches;
    button.setAttribute('aria-expanded', String(isOpen));
    button.setAttribute('aria-label', isOpen ? 'Close menu' : 'Menu');
    panel.classList.toggle('hidden', !isOpen);
    header?.classList.toggle('expanded', isOpen);
    document.body.classList.toggle('overflow-hidden', isOpen);
    setBackgroundInert(isOpen);
    if (isOpen) {
      panel.querySelector<HTMLElement>('a, button')?.focus();
    } else if (restoreFocus) {
      button.focus();
    }
  }

  function menuIsOpen() {
    return menuParts().button?.getAttribute('aria-expanded') === 'true';
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target) return;
    if (target.closest('[data-aw-toggle-menu]')) {
      setMenu(!menuIsOpen(), { restoreFocus: true });
      return;
    }
    // A link in the open menu navigates; close the menu first.
    if (menuIsOpen() && target.closest('[data-menu-panel] a')) {
      setMenu(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuIsOpen()) {
      event.preventDefault();
      setMenu(false, { restoreFocus: true });
    }
  });

  // Rotating or resizing to desktop width closes the mobile menu.
  desktop.addEventListener('change', () => setMenu(false));

  // ---- Header: measured height and scroll state ---------------------------------------------------------------

  // The mobile menu panel starts below the header. Measure the header instead of hard-coding its height.
  let headerResize: ResizeObserver | null = null;

  function watchHeaderHeight() {
    headerResize?.disconnect();
    const header = document.getElementById('header');
    if (!header) return;
    headerResize = new ResizeObserver(() => {
      document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    });
    headerResize.observe(header);
  }

  let scrollQueued = false;

  function updateHeaderScroll() {
    scrollQueued = false;
    document.querySelector('#header[data-aw-sticky-header]')?.classList.toggle('scroll', window.scrollY > 60);
  }

  // One listener for the whole session; at most one header update per animation frame.
  window.addEventListener(
    'scroll',
    () => {
      if (scrollQueued) return;
      scrollQueued = true;
      window.requestAnimationFrame(updateHeaderScroll);
    },
    { passive: true }
  );

  // ---- Reveal-on-scroll animations ----------------------------------------------------------------------------
  // Inspired by https://github.com/heidkaemper/tailwindcss-intersect

  type RevealElement = HTMLElement & { _intersectionThreshold?: number };

  const DELAY_BETWEEN_ANIMATIONS = 100;
  let revealObserver: IntersectionObserver | null = null;
  let animationCounter = 0;

  function startReveal() {
    // Disconnect the previous page's observer, and reset the queue so delays do not carry over between pages.
    revealObserver?.disconnect();
    animationCounter = 0;

    const selectors = [
      '[class*=" intersect:"]',
      '[class*=":intersect:"]',
      '[class^="intersect:"]',
      '[class="intersect"]',
      '[class*=" intersect "]',
      '[class^="intersect "]',
      '[class$=" intersect"]',
    ];
    const elements = Array.from(document.querySelectorAll<RevealElement>(selectors.join(',')));

    const thresholdFor = (el: Element) => {
      if (el.classList.contains('intersect-full')) return 0.99;
      if (el.classList.contains('intersect-half')) return 0.5;
      if (el.classList.contains('intersect-quarter')) return 0.25;
      return 0;
    };

    elements.forEach((el) => {
      el.setAttribute('no-intersect', '');
      el._intersectionThreshold = thresholdFor(el);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const target = entry.target as RevealElement;
          const threshold = target._intersectionThreshold ?? 0;

          if (target.classList.contains('intersect-no-queue')) {
            if (entry.isIntersecting) {
              target.removeAttribute('no-intersect');
              if (target.classList.contains('intersect-once')) observer.unobserve(target);
            } else {
              target.setAttribute('no-intersect', '');
            }
            return;
          }

          if (entry.intersectionRatio >= threshold) {
            if (!target.hasAttribute('data-animated')) {
              target.removeAttribute('no-intersect');
              target.setAttribute('data-animated', 'true');
              const delay = animationCounter * DELAY_BETWEEN_ANIMATIONS;
              animationCounter++;
              target.style.transitionDelay = `${delay}ms`;
              target.style.animationDelay = `${delay}ms`;
              if (target.classList.contains('intersect-once')) observer.unobserve(target);
            }
          } else {
            target.setAttribute('no-intersect', '');
            target.removeAttribute('data-animated');
            target.style.transitionDelay = '';
            target.style.animationDelay = '';
            animationCounter = 0;
          }
        });
      },
      { threshold: [0, 0.25, 0.5, 0.99] }
    );

    elements.forEach((el) => observer.observe(el));
    revealObserver = observer;
  }

  // ---- Per page -----------------------------------------------------------------------------------------------

  document.addEventListener('astro:page-load', () => {
    // ClientRouter copies <html> attributes from the new page, so re-apply this on every page.
    document.documentElement.classList.add('motion-safe:scroll-smooth');
    setMenu(false);
    watchHeaderHeight();
    updateHeaderScroll();
    startReveal();
  });
</script>
