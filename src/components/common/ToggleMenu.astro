---
/*
 * Menu toggle button. BasicScripts.astro keeps aria-expanded in sync with the panel named by `controls`.
 */
export interface Props {
  label?: string;
  class?: string;
  controls: string;
}

const { label = 'Menu', class: className = '', controls } = Astro.props;
---

<button
  type="button"
  class:list={['flex h-12 w-12 flex-col items-center justify-center rounded group', className]}
  aria-label={label}
  aria-controls={controls}
  aria-expanded="false"
  data-aw-toggle-menu
>
  <span
    aria-hidden="true"
    class="my-1 h-0.5 w-6 rounded-full bg-chocolate opacity-80 transition duration-200 group-aria-expanded:translate-y-2.5 group-aria-expanded:rotate-45"
  ></span>
  <span
    aria-hidden="true"
    class="my-1 h-0.5 w-6 rounded-full bg-chocolate opacity-80 transition duration-200 group-aria-expanded:opacity-0"
  ></span>
  <span
    aria-hidden="true"
    class="my-1 h-0.5 w-6 rounded-full bg-chocolate opacity-80 transition duration-200 group-aria-expanded:-translate-y-2.5 group-aria-expanded:-rotate-45"
  ></span>
</button>
