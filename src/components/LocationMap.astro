---
/*
 * Google Maps embed. Google can set cookies, so the whole map is hidden and the iframe has no src until the visitor
 * accepts cookies. CookieConsent.astro shows it and sets the src on accept, and hides it again on reject.
 */
import { BUSINESS } from '~/utils/site';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<figure class:list={['not-prose hidden', className]} data-consent-map>
  <div class="swatch overflow-hidden border border-gold/60 bg-sand">
    <iframe
      data-src={BUSINESS.map.embed}
      title={`Map showing ${BUSINESS.name} at ${BUSINESS.address.join(', ')}`}
      class="block w-full h-72 md:h-96 border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </div>
  <figcaption class="mt-3 text-right">
    <a
      href={BUSINESS.map.link}
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs uppercase tracking-[0.3em] underline decoration-chocolate/40 underline-offset-8 hover:decoration-chocolate"
      >Open in Google Maps</a
    >
  </figcaption>
</figure>
