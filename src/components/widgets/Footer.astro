---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { BUSINESS } from '~/utils/site';
import { getPermalink } from '~/utils/permalinks';
import logoDark from '~/assets/images/logo-dark.png';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

export interface Props {
  socialLinks?: Array<Link>;
  footNote?: string;
  [key: string]: unknown;
}

const { socialLinks = [], footNote = '' } = Astro.props;
const pages = [
  { text: 'Home', href: getPermalink('/') },
  { text: 'Services', href: getPermalink('/services') },
  { text: 'About Us', href: getPermalink('/about') },
  { text: 'Contact Us', href: getPermalink('/contact') },
];
---

<footer class="on-dark bg-chocolate text-cream not-prose">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-10 grid gap-10 md:grid-cols-4 text-sm">
    <div class="md:col-span-1">
      <Image src={logoDark} alt={`${BUSINESS.name} logo`} width={220} class="w-[5.5rem] h-auto" />
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-gold mb-4">Visit</p>
      <address class="not-italic leading-relaxed">
        {BUSINESS.address.map((line) => <div>{line}</div>)}
      </address>
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-gold mb-4">Explore</p>
      <ul class="space-y-2">
        {
          pages.map((p) => (
            <li>
              <a class="hover:text-sand hover:underline underline-offset-4" href={p.href}>
                {p.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-gold mb-4">Get in touch</p>
      <ul class="space-y-2">
        <li>
          <a class="hover:text-sand hover:underline underline-offset-4" href={`tel:${BUSINESS.phoneHref}`}
            >{BUSINESS.phoneDisplay}</a
          >
        </li>
        <li>
          <a class="hover:text-sand hover:underline underline-offset-4" href={`mailto:${BUSINESS.email}`}
            >{BUSINESS.email}</a
          >
        </li>
      </ul>
      <ul class="flex gap-4 mt-5">
        {
          socialLinks.map((s) => (
            <li>
              <a href={s.href} aria-label={s.ariaLabel} class="text-gold hover:text-cream transition-colors">
                {s.icon && <Icon name={s.icon} class="w-5 h-5" />}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div
      class="border-t border-gold/40 py-6 flex flex-col sm:flex-row gap-3 sm:gap-6 items-center justify-center text-xs tracking-wide text-sand"
    >
      <span>{footNote}</span>
      <a class="hover:text-cream underline underline-offset-4" href={getPermalink('/privacy')}>Privacy notice</a>
      <button type="button" class="hover:text-cream underline underline-offset-4" data-cookie-settings>
        Cookie settings
      </button>
    </div>
  </div>
</footer>
