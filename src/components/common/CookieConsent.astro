---
/*
 * Cookie consent banner: one choice, "Accept cookies" or "Reject cookies".
 *
 *   Accept: loads Google Analytics 4 (ANALYTICS_ID in src/utils/deploy.ts) and shows the Google Maps embed.
 *   Reject: closes the banner. Google Analytics stays off (and its cookies are deleted), and the map is hidden.
 * Until the visitor chooses, neither loads. The page stays usable behind the banner.
 *
 * The choice is kept in localStorage under CONSENT_KEY ("accepted" or "rejected"), and mirrored on
 * <html data-consent> so CSS can reserve the map space before the page draws (see Layout.astro).
 * A choice made in this tab wins over the stored value, so Reject works even when storage writes fail.
 * Choices made in another tab are applied here through the `storage` event.
 * Any element with [data-cookie-settings] opens the banner again, so the visitor can change their choice.
 */
import { getPermalink } from '~/utils/permalinks';
import { ANALYTICS_ID } from '~/utils/deploy';
---

<div
  id="cookie-consent"
  class="on-dark fixed inset-x-0 bottom-0 z-50 hidden px-4 pb-[calc(1rem+env(safe-area-inset-bottom))] sm:px-6 sm:pb-[calc(1.5rem+env(safe-area-inset-bottom))]"
  role="region"
  aria-label="Cookies"
  data-ga-id={ANALYTICS_ID || undefined}
>
  <div
    class="mx-auto max-h-[60dvh] overflow-y-auto max-w-3xl rounded-r-[2.5rem] rounded-l-lg bg-chocolate text-cream px-6 py-5 md:px-8 shadow-[0_8px_40px_rgb(59_42_32/0.35)] md:flex md:items-center md:gap-8"
  >
    <p class="text-sm font-light leading-relaxed text-sand md:flex-1">
      We use cookies on this website. Check our <a
        href={getPermalink('/privacy')}
        class="text-cream underline underline-offset-4 hover:text-gold">privacy policy</a
      >.
    </p>
    <div class="mt-4 md:mt-0 flex flex-col sm:flex-row gap-3 shrink-0">
      <button type="button" class="btn-primary py-3 px-6 text-xs" data-cookie-choice="accepted">Accept cookies</button>
      <button type="button" class="btn py-3 px-6 text-xs" data-cookie-choice="rejected">Reject cookies</button>
    </div>
  </div>
</div>

<script>
  type Consent = 'accepted' | 'rejected' | null;

  const CONSENT_KEY = 'hs-cookie-consent';

  function readConsent(): Consent {
    try {
      const value = window.localStorage.getItem(CONSENT_KEY);
      return value === 'accepted' || value === 'rejected' ? value : null;
    } catch {
      return null;
    }
  }

  // The choice made in this tab. It wins over the stored value, so a Reject still applies when storage reads
  // succeed but writes fail. It is mirrored on window so the inline <head> script in Layout.astro can read it.
  let sessionConsent: Consent = null;

  function setSessionConsent(value: Consent) {
    sessionConsent = value;
    window.__hsConsentSession = value ?? undefined;
  }

  function currentConsent(): Consent {
    return sessionConsent ?? readConsent();
  }

  function saveConsent(value: Exclude<Consent, null>) {
    setSessionConsent(value);
    try {
      window.localStorage.setItem(CONSENT_KEY, value);
    } catch {
      // Storage blocked: the in-memory choice applies until the next full page load.
    }
  }

  function banner() {
    return document.getElementById('cookie-consent');
  }

  // Publish the banner height as --cookie-banner-h, so the mobile menu can keep its links above the banner.
  let bannerResize: ResizeObserver | null = null;

  function showBanner(show: boolean) {
    const el = banner();
    el?.classList.toggle('hidden', !show);
    bannerResize?.disconnect();
    const root = document.documentElement;
    if (show && el) {
      bannerResize = new ResizeObserver(() => root.style.setProperty('--cookie-banner-h', `${el.offsetHeight}px`));
      bannerResize.observe(el);
    } else {
      root.style.setProperty('--cookie-banner-h', '0px');
    }
  }

  // ---- Google Analytics -------------------------------------------------------------------------------------

  let analyticsLoaded = false;

  function loadAnalytics(id: string) {
    window[`ga-disable-${id}`] = false;
    if (analyticsLoaded) {
      window.gtag?.('consent', 'update', { analytics_storage: 'granted' });
      return;
    }
    analyticsLoaded = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag() {
      // gtag.js reads the arguments object, not an array, so push `arguments`.
      // eslint-disable-next-line prefer-rest-params
      window.dataLayer!.push(arguments);
    };
    // No advertising features. Analytics storage is granted because the visitor accepted cookies.
    window.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'granted',
    });
    window.gtag('js', new Date());
    // GA4 enhanced measurement counts view-transition navigations as page views (browser history events).
    window.gtag('config', id);
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
    document.head.appendChild(script);
  }

  function stopAnalytics(id: string) {
    window[`ga-disable-${id}`] = true;
    window.gtag?.('consent', 'update', { analytics_storage: 'denied' });
    // Remove the Google Analytics cookies (_ga and _ga_<container>) that are already set.
    const host = window.location.hostname;
    const domains = ['', host, `.${host}`, `.${host.replace(/^www\./, '')}`];
    document.cookie.split(';').forEach((cookie) => {
      const name = cookie.split('=')[0].trim();
      if (name === '_ga' || name.startsWith('_ga_')) {
        domains.forEach((domain) => {
          document.cookie = `${name}=; Max-Age=0; path=/${domain ? `; domain=${domain}` : ''}`;
        });
      }
    });
  }

  // ---- Google Maps ------------------------------------------------------------------------------------------

  // The map box is shown by CSS from <html data-consent="accepted">. Load the iframe only after acceptance,
  // and remove its src again on reject so nothing more is sent to Google.
  function applyMaps(accepted: boolean) {
    document.querySelectorAll<HTMLIFrameElement>('[data-consent-map] iframe[data-src]').forEach((frame) => {
      if (accepted) {
        if (!frame.getAttribute('src')) frame.setAttribute('src', frame.dataset.src ?? '');
      } else {
        frame.removeAttribute('src');
      }
    });
  }

  // ---- Apply and choose -------------------------------------------------------------------------------------

  function applyConsent() {
    const consent = currentConsent();
    const accepted = consent === 'accepted';
    if (consent) document.documentElement.dataset.consent = consent;
    else delete document.documentElement.dataset.consent;
    const id = banner()?.dataset.gaId ?? '';
    if (id) {
      if (accepted) loadAnalytics(id);
      else if (analyticsLoaded || document.cookie.includes('_ga')) stopAnalytics(id);
    }
    applyMaps(accepted);
  }

  // One delegated listener survives Astro view transitions, which replace the page body.
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target) return;

    const choice = target.closest<HTMLElement>('[data-cookie-choice]')?.dataset.cookieChoice;
    if (choice === 'accepted' || choice === 'rejected') {
      saveConsent(choice);
      showBanner(false);
      applyConsent();
      return;
    }

    if (target.closest('[data-cookie-settings]')) {
      event.preventDefault();
      showBanner(true);
      banner()?.querySelector<HTMLElement>('[data-cookie-choice]')?.focus();
    }
  });

  // Another tab changed the choice: apply it here too.
  window.addEventListener('storage', (event) => {
    if (event.key !== CONSENT_KEY) return;
    setSessionConsent(null);
    showBanner(currentConsent() === null);
    applyConsent();
  });

  // Runs on the first load and after each view-transition navigation.
  document.addEventListener('astro:page-load', () => {
    showBanner(currentConsent() === null);
    applyConsent();
  });
</script>
