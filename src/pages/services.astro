---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { SERVICES } from '~/utils/site';

const metadata = { title: 'Services' };
---

<Layout metadata={metadata}>
  <Hero
    tagline="Services and prices"
    title="Our services"
    subtitle="Placeholder prices: replace with the salon's real price list."
  />

  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-20 md:pb-28 grid gap-6 md:grid-cols-2">
    {
      SERVICES.map((service) => (
        <div class="swatch bg-sand p-8 md:p-10">
          <h2 class="font-heading text-5xl leading-[1.1] mb-2">{service.title}</h2>
          <p class="font-light text-chocolate/90 mb-6">{service.description}</p>
          <ul class="divide-y divide-gold/50">
            {service.items.map((item: { name: string; price: string }) => (
              <li class="flex justify-between gap-4 py-3">
                <span class="font-light">{item.name}</span>
                <span class="font-medium whitespace-nowrap">{item.price}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <CallToAction
    title="Book your appointment"
    subtitle="Not sure what you need? Ask us for advice."
    actions={[{ variant: 'primary', text: 'Contact us', href: '/contact' }]}
  />
</Layout>
