---
export interface Props {
  title: string;
  items: Array<{ question: string; answer: string }>;
}

const { title, items } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-16">
  <h2 class="text-3xl font-semibold text-accent">{title}</h2>
  <div class="mt-8 space-y-6">
    {
      items.map((item) => (
        <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <h3 class="text-xl font-semibold text-white">{item.question}</h3>
          <p class="mt-3 leading-relaxed text-white/80">{item.answer}</p>
        </article>
      ))
    }
  </div>
</section>
