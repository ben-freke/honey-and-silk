---
/*
 * Google Maps embed with a directions link.
 *
 * Google can set cookies, so the map box shows only when <html data-consent="accepted"> (CSS in tailwind.css),
 * and CookieConsent.astro sets the iframe src only after acceptance. The attribute is set in <head> before the
 * page draws, so a returning visitor who accepted sees the map space at once, without a layout shift.
 * The "Open in Google Maps" link is an ordinary link and is always shown, also when cookies are rejected.
 */
import { BUSINESS } from '~/utils/site';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<figure class:list={['not-prose', className]} data-consent-map>
  <div class="swatch overflow-hidden border border-gold/60 bg-sand mb-3" data-consent-map-frame>
    <iframe
      data-src={BUSINESS.map.embed}
      title={`Map showing ${BUSINESS.name} at ${BUSINESS.address.join(', ')}`}
      class="block w-full h-72 md:h-96 border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </div>
  <figcaption class="text-right">
    <a
      href={BUSINESS.map.link}
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs uppercase tracking-[0.3em] underline decoration-chocolate/40 underline-offset-8 hover:decoration-chocolate"
      >Open in Google Maps</a
    >
  </figcaption>
</figure>
