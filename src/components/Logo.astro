---
/*
 * Header logo: the primary monogram logo from the brand guide (page 3), trimmed to its edges.
 */
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import logo from '~/assets/images/logo.png';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<Image
  src={logo}
  alt={SITE?.name ?? 'Honey & Silk Hair'}
  width={240}
  loading="eager"
  class:list={['h-12 md:h-20 w-auto', className]}
/>
