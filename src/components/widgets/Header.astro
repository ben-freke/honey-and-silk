---
/*
 * Site header.
 *
 * Below the lg breakpoint (1024px) the links are in a menu panel that the toggle button opens. The panel is a
 * disclosure: the button has aria-expanded and aria-controls, Escape closes the panel and returns focus to the
 * button, and BasicScripts.astro makes the page behind the open panel inert.
 * At lg and wider, the header is a three-track grid (logo | links | action), so the links never squeeze the logo.
 */
import Logo from '~/components/Logo.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink, trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
}

export interface Props {
  id?: string;
  links?: Array<Link>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
}

const { id = 'header', links = [], actions = [], isSticky = false } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  class:list={[{ sticky: isSticky, relative: !isSticky }, 'top-0 z-40 w-full']}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  id={id}
>
  <div class="absolute inset-0 bg-page transition-shadow"></div>
  <div
    class="relative mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 text-default lg:grid lg:grid-cols-[auto_1fr_auto] lg:px-6"
  >
    <a class="flex shrink-0 items-center text-chocolate" href={getHomePermalink()}>
      <Logo />
    </a>

    <ToggleMenu class="lg:hidden" controls="main-nav" />

    <nav
      id="main-nav"
      aria-label="Main navigation"
      class="hidden fixed inset-x-0 bottom-0 top-[var(--header-h,81px)] overflow-y-auto overscroll-contain bg-page px-4 pt-2 pb-[calc(1.5rem+var(--cookie-banner-h,0px)+env(safe-area-inset-bottom))] lg:static lg:block lg:overflow-visible lg:bg-transparent lg:p-0"
      data-menu-panel
    >
      <ul
        class="flex flex-col text-lg uppercase tracking-[0.2em] font-medium text-mocha lg:flex-row lg:flex-wrap lg:justify-center lg:text-xs"
      >
        {
          links.map(({ text, href }) => (
            <li>
              <a
                class:list={[
                  'block px-1 py-3 hover:text-chocolate transition-colors lg:px-4 lg:whitespace-nowrap',
                  { 'aw-link-active': href === currentPath },
                ]}
                href={href}
                aria-current={href === currentPath ? 'page' : undefined}
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
      {
        actions?.length ? (
          <div class="mt-6 flex flex-col gap-3 lg:hidden">
            {actions.map((btnProps) => (
              <Button {...btnProps} class="w-full py-3 text-xs" />
            ))}
          </div>
        ) : null
      }
    </nav>

    {
      actions?.length ? (
        <div class="hidden lg:flex lg:justify-end">
          {actions.map((btnProps) => (
            <Button {...btnProps} class="py-2.5 px-6 text-xs" />
          ))}
        </div>
      ) : null
    }
  </div>
</header>
