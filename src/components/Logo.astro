---
/*
 * Secondary logo from the brand guide (page 6): "Honey & Silk" in Great Vibes. The "HAIR" part is left out.
 * The header uses this text lockup because the monogram logo is too detailed at small sizes.
 */

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-baseline gap-2 whitespace-nowrap', className]}>
  <span class="font-heading text-[2rem] md:text-[2.5rem] leading-none">Honey &amp; Silk</span>
</span>
