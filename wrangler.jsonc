// Cloudflare Workers static assets config.
//
// Deploys come from Workers Builds (the Cloudflare GitHub integration, set up in the Cloudflare dashboard):
//   - A pull request uploads a preview version, and the Cloudflare app comments the preview URL on the PR.
//   - A merge to main deploys to production.
// Build settings in the dashboard: build command `npm run build`, deploy command `npx wrangler deploy`,
// non-production branch deploy command `npx wrangler versions upload`.
//
// The site is fully static. Cloudflare applies public/_headers (copied to dist/_headers) to every response.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honey-and-silk",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // Astro builds about.html (build.format 'file'); serve it at /about, and redirect /about/ and /about.html there.
    "html_handling": "drop-trailing-slash",
  },
  // Preview URLs for pull request builds.
  "preview_urls": true,
  //
  // Custom domain: uncomment when honeyandsilk.co.uk is a zone in the same Cloudflare account.
  // "routes": [
  //   { "pattern": "honeyandsilk.co.uk", "custom_domain": true },
  //   { "pattern": "www.honeyandsilk.co.uk", "custom_domain": true },
  // ],
}
