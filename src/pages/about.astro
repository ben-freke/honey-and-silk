---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { title: 'About Us' };
---

<Layout metadata={metadata}>
  <Hero
    tagline="About us"
    title="The story behind Honey & Silk Hair"
    subtitle="Placeholder: a short line about the salon."
  />

  <section
    class="max-w-3xl mx-auto px-4 sm:px-6 pb-20 md:pb-28 prose prose-lg font-light prose-p:text-chocolate prose-headings:font-heading prose-headings:font-normal prose-headings:text-chocolate prose-h2:text-5xl prose-h2:leading-[1.1] prose-h2:mb-4"
  >
    <h2>Our story</h2>
    <p>
      After 16 years of cutting hair, building connections and doing what I love, I have opened my very own salon. When
      the opportunity came along, I knew it was time to take the leap and turn my dream into reality.
    </p>
    <h2>Our approach</h2>
    <p>
      Every little detail has been created with love, care and thought, with one thing at the heart of it all: making
      you feel truly special, from the moment you walk through the door.
    </p>
    <h2>Meet the team</h2>
    <p>Placeholder: add the owner's name, role and photo here.</p>
  </section>

  <CallToAction
    title="Come and say hello"
    subtitle="We would love to meet you."
    actions={[{ variant: 'primary', text: 'Contact us', href: '/contact' }]}
  />
</Layout>
